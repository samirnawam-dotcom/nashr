{
  "name": "nashr",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "tsx server/core/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/main.ts",
    "seed": "tsx server/seed.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "e2e": "node e2e/buyer-journey.cjs && node e2e/seller-journey.cjs && node e2e/admin-journey.cjs"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
